<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Main app theme - White background for light mode -->
    <style name="Theme.SkoolSwap" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color - WHITE for surfaces -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/light_gray</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Secondary - BLACK for accents -->
        <item name="colorSecondary">@color/black</item>
        <item name="colorSecondaryVariant">@color/dark_gray</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Surface and Background - WHITE for light mode -->
        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>

        <!-- Status bar - White with black icons -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation bar - White with black icons -->
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/dark_gray</item>

        <!-- Remove elevation -->
        <item name="android:elevation">0dp</item>
        <item name="android:windowContentOverlay">@null</item>

        <!-- Button styles -->
        <item name="materialButtonStyle">@style/Widget.SkoolSwap.Button.Light</item>

        <!-- FAB style - Black with white icon for light mode -->
        <item name="floatingActionButtonStyle">@style/Widget.SkoolSwap.FAB.Light</item>
    </style>

    <!-- Login Screen Theme - Black background -->
    <style name="Theme.SkoolSwap.Login" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Force black background for login screen -->
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@color/white</item>

        <!-- Status bar - Black with white icons -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation bar - Black -->
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Text colors - White on black -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/light_gray</item>
    </style>

    <!-- NoActionBar variant -->
    <style name="Theme.SkoolSwap.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Light mode button - Black background, white text -->
    <style name="Widget.SkoolSwap.Button.Light" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/black</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Light mode FAB - Black background, white icon -->
    <style name="Widget.SkoolSwap.FAB.Light" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/black</item>
        <item name="tint">@color/white</item>
        <item name="rippleColor">@color/medium_gray</item>
    </style>

    <!-- AppBarOverlay for toolbar -->
    <style name="Theme.SkoolSwap.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/dark_gray</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="actionMenuTextColor">@color/black</item>
    </style>

    <!-- PopupOverlay -->
    <style name="Theme.SkoolSwap.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light" />

    <!-- GoldRatingBar -->
    <style name="GoldRatingBar" parent="Widget.AppCompat.RatingBar.Small">
        <item name="android:minHeight">20dp</item>
        <item name="android:maxHeight">20dp</item>
        <item name="android:progressDrawable">@drawable/rating_bar_gold</item>
    </style>

</resources>