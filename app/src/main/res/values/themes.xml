<resources xmlns:tools="http://schemas.android.com/apk/res/android">
    <!-- Base application theme with WHITE as primary -->
    <style name="Theme.SkoolSwap" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color - WHITE -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/gray_light</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/purple_500</item>
        <item name="colorSecondaryVariant">@color/purple_700</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Surface and Background -->
        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/gray_dark</item>

        <!-- Remove elevation -->
        <item name="android:elevation">0dp</item>
        <item name="android:windowContentOverlay">@null</item>

        <!-- Button colors -->
        <item name="materialButtonStyle">@style/Widget.SkoolSwap.Button</item>
    </style>

    <style name="Theme.SkoolSwap.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Custom Button Style -->
    <style name="Widget.SkoolSwap.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/purple_500</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- AppBarOverlay for toolbar -->
    <style name="Theme.SkoolSwap.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/gray_dark</item>
        <item name="colorOnPrimary">@color/black</item>
    </style>

    <style name="Theme.SkoolSwap.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light" />

    <!-- GoldRatingBar remains the same -->
    <style name="GoldRatingBar" parent="Widget.AppCompat.RatingBar.Small">
        <item name="android:minHeight">20dp</item>
        <item name="android:maxHeight">20dp</item>
        <item name="android:progressDrawable">@drawable/rating_bar_gold</item>
    </style>
</resources>