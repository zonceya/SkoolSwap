<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- CHANGE PARENT to NoActionBar -->
    <style name="Theme.SkoolSwap" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- ADD THESE - Launch window background -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowIsTranslucent">false</item>

        <!-- Primary brand color - WHITE for light mode -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/light_background</item>
        <item name="colorOnBackground">@color/black</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/white</item>

        <item name="android:elevation">0dp</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="colorSurfaceVariant">#EEEEEE</item>
        <item name="colorOnSurfaceVariant">#666666</item>
        <!-- Control colors -->
        <item name="colorControlNormal">@color/black</item>
        <item name="colorControlActivated">@color/black</item>
        <item name="colorControlHighlight">@color/black_transparent_20</item>
        <item name="colorAccent">@color/teal_200</item>
        <item name="elevationOverlayEnabled">false</item>

        <!-- Action Bar Theme - CONNECT THE OVERLAY -->
        <item name="actionBarTheme">@style/Theme.SkoolSwap.AppBarOverlay</item>
    </style>
    <!-- Dialog Animation -->
    <style name="DialogAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
    <style name="LogoutButtonStyle" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/black</item>
        <item name="android:textColor">@android:color/white</item>
    </style>
    <style name="SizeBadgeStyle" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/black</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
    <style name="WhiteOutlinedBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/white</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@android:color/transparent</item>
        <item name="hintTextColor">@color/white</item>
    </style>
    <!-- Rest of your styles remain the same -->
    <style name="CustomTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/black_70</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="CustomTabTextSelected" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Theme.SkoolSwap.NoActionBar" parent="Theme.SkoolSwap">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="GoldRatingBar" parent="Widget.AppCompat.RatingBar.Small">
        <item name="android:minHeight">20dp</item>
        <item name="android:maxHeight">20dp</item>
        <item name="android:progressDrawable">@drawable/rating_bar_gold</item>
    </style>

    <style name="Theme.SkoolSwap.AppBarOverlay" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/black_70</item>
        <item name="actionMenuTextColor">@color/black</item>
    </style>

    <style name="FullScreenDialogStyle" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>

    <style name="Theme.SkoolSwap.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>