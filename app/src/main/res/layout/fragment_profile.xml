<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".ProfileFragment">

        <!-- Profile Container -->
        <RelativeLayout
            android:id="@+id/profileLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Profile Image with Circular Background -->
            <RelativeLayout
                android:id="@+id/profileImageContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:background="@drawable/circle_background"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="user_profile_picture"
                    android:src="@drawable/ic_user" />
            </RelativeLayout>

            <!-- Change Photo Button -->
            <TextView
                android:id="@+id/changePhotoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/profileImageContainer"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="8dp"
                android:text="change_photo"
                android:visibility="gone"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <!-- Name Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/userNameTextInputLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/changePhotoText"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:hint="@string/name"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeErrorColor="@color/red"
                app:errorIconTint="@color/red"
                app:errorTextColor="@color/red">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/profile_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:textColor="?attr/colorOnSurface"  />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Contact Number Field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/mobileTextInputLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/userNameTextInputLayout"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:hint="@string/contact_number"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeErrorColor="@color/red"
                app:errorIconTint="@color/red"
                app:errorTextColor="@color/red">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/contactNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_edit"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:textColor="?attr/colorOnSurface"  />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Province Dropdown -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/provinceTextInputLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/mobileTextInputLayout"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:hint="@string/select_province"

                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:endIconMode="dropdown_menu"
                app:startIconDrawable="@drawable/ic_location"
                app:startIconTint="?attr/colorOnSurface">

                <AutoCompleteTextView
                    android:paddingEnd="45dp"
                    android:paddingStart="45dp"
                    android:id="@+id/provinceSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="?attr/colorOnSurface"  />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- School Search -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/schoolSearchLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/provinceTextInputLayout"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:hint="@string/search_school"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="?attr/colorOnSurface"
                app:endIconTint="?attr/colorOnSurface"
                app:placeholderText="@string/select_province_first"
                app:placeholderTextColor="@color/darker_grey_light">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/schoolSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:inputType="text"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="@color/darker_grey_light"
                    android:paddingEnd="8dp"
                    android:paddingStart="8dp" />
            </com.google.android.material.textfield.TextInputLayout>
            <!-- Selected School Display -->
            <TextView
                android:id="@+id/selectedSchoolText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/schoolSearchLayout"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="@string/no_school_selected"
                android:textColor="@color/lightgray"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Search Results -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/schoolResultsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/selectedSchoolText"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:maxHeight="200dp"
                android:visibility="gone"
                android:background="@drawable/rounded_background"
                android:elevation="4dp" />

            <!-- No Results Message -->
            <TextView
                android:id="@+id/noResultsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/selectedSchoolText"
                android:layout_marginTop="16dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="@string/no_schools_found"
                android:textAlignment="center"
                android:textColor="@color/lightgray"
                android:visibility="gone" />

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/schoolResultsRecyclerView"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ic_rounded"
                android:enabled="true"
                android:text="@string/submit"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <!-- Delete Profile Warning -->
            <TextView
                android:id="@+id/deleteWarningTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/submitButton"
                android:layout_marginTop="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="Delete Profile"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <TextView
                android:id="@+id/deleteWarningText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/deleteWarningTitle"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="@string/deleting_your_account_is_permanent_and_cannot_be_undone_all_your_data_will_be_permanently_lost"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:visibility="visible" />

            <!-- Delete Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/deleteWarningText"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ic_rounded"
                android:text="@string/delete_profile"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="visible"
                app:backgroundTint="@null" />
        </RelativeLayout>

        <!-- Loading Indicator -->
        <LinearLayout
            android:id="@+id/profileProgressLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>