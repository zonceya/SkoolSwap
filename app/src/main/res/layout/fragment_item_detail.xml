<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="16dp">

        <!-- Image placeholder shimmer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="@color/shimmer_background" />

        <!-- Title shimmer -->
        <View
            android:layout_width="200dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:background="@color/shimmer_background" />

        <!-- Price shimmer -->
        <View
            android:layout_width="100dp"
            android:layout_height="32dp"
            android:layout_marginTop="8dp"
            android:background="@color/shimmer_background" />

        <!-- Divider shimmer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/shimmer_background" />

        <!-- Description shimmer lines -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="12dp"
            android:background="@color/shimmer_background" />

        <View
            android:layout_width="250dp"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            android:background="@color/shimmer_background" />

    </LinearLayout>
    <LinearLayout
        android:id="@+id/errorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="32dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_error_placeholder" />

        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Failed to load item"
            android:textSize="16sp"
            android:textColor="#666"
            android:layout_marginTop="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Retry"
            android:layout_marginTop="24dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="80dp"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========================= -->
            <!-- IMAGE + TOP BAR -->
            <!-- ========================= -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/imageSlider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/backBtn"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_back"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp"
                        app:tint="?attr/colorOnSurface" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <ImageView
                        android:id="@+id/favBtn"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_favorite"
                        app:tint="?attr/colorOnSurface" />

                    <ImageView
                        android:id="@+id/shareBtn"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_share"
                        app:tint="?attr/colorOnSurface" />

                </LinearLayout>

                <TextView
                    android:id="@+id/soldBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SOLD"
                    android:textColor="@android:color/white"
                    android:background="@android:color/holo_red_dark"
                    android:padding="8dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp"
                    android:visibility="gone"/>

            </FrameLayout>

            <!-- ========================= -->
            <!-- PRODUCT INFO -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Title Row with View Count -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/productTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <LinearLayout
                        android:id="@+id/viewCountContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_rounded"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_eye"
                            app:tint="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/viewCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12sp"
                            android:layout_marginStart="4dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Brand -->
                <TextView
                    android:id="@+id/productBrand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"/>

                <!-- Color -->
                <TextView
                    android:id="@+id/productColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"/>

                <!-- Price -->
                <TextView
                    android:id="@+id/productPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="8dp"/>

                <!-- Size -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/productSize"
                    style="@style/SizeBadgeStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"/>

                <!-- Condition -->
                <TextView
                    android:id="@+id/productCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOnSurface"
                    android:alpha="0.12"
                    android:layout_marginTop="16dp"/>

                <!-- School -->
                <TextView
                    android:id="@+id/productSchool"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOnSurface"
                    android:alpha="0.12"
                    android:layout_marginTop="16dp"/>

                <!-- Description -->
                <TextView
                    android:id="@+id/productDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOnSurface"
                    android:alpha="0.12"
                    android:layout_marginTop="16dp"/>

                <!-- ========================= -->
                <!-- SHIPPING SECTION (FIRST) -->
                <!-- ========================= -->

                <LinearLayout
                    android:id="@+id/shippingHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Shipping &amp; Returns"
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.7"/>

                    <TextView
                        android:id="@+id/shippingToggle"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:text="+"
                        android:textSize="20sp"
                        android:textAlignment="center"
                        android:textColor="?attr/colorOnSurface"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/shippingExpandableContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp">

                    <!-- Lottie Animation -->
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/shippingAnimation"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        app:lottie_rawRes="@raw/sad_animation"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"/>

                    <!-- Sad Text -->
                    <TextView
                        android:id="@+id/shippingText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="We are working with our partners to bring you the best courier service"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.7"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"/>

                </LinearLayout>

                <!-- ========================= -->
                <!-- SIMILAR ITEMS (BELOW SHIPPING) -->
                <!-- ========================= -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOnSurface"
                    android:alpha="0.12"
                    android:layout_marginTop="16dp"/>

                <TextView
                    android:id="@+id/similarSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Similar Items"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="16dp"/>

                <ProgressBar
                    android:id="@+id/similarProgressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"/>
                <LinearLayout
                    android:id="@+id/similarShimmer"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <!-- Repeat this block 3 times for fake cards -->
                    <View
                        android:layout_width="120dp"
                        android:layout_height="160dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/shimmer_background"/>

                    <View
                        android:layout_width="120dp"
                        android:layout_height="160dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/shimmer_background"/>

                    <View
                        android:layout_width="120dp"
                        android:layout_height="160dp"
                        android:background="@color/shimmer_background"/>

                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/similarRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Buy Button - Light mode: black background with white text, Dark mode: white background with black text -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buyButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="I'm Interested"
        android:textColor="@color/white"
        android:backgroundTint="?attr/colorOnSurface"
        android:layout_margin="16dp"
        android:layout_gravity="bottom"
        app:cornerRadius="12dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>