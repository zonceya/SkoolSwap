<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/deleteAccountDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- Warning icon -->
    <ImageView
        android:id="@+id/iconWarning"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/cd_warning"
        app:tint="@color/black"
        app:srcCompat="@drawable/ic_warning" />

    <!-- Title -->
    <TextView
        android:id="@+id/titleDeleteAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/title_delete_account"
        android:textAppearance="?attr/textAppearanceHeadline6"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Message -->
    <TextView
        android:id="@+id/messageDeleteAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/msg_delete_account"
        android:textAppearance="?attr/textAppearanceBody2"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

    <!-- Buttons row - CENTERED with equal weights -->
    <LinearLayout
        android:id="@+id/actionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <!-- Keep account (secondary) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeep"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_keep_account"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/black"
            android:textColor="@color/black" />

        <!-- Delete account (destructive) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/btn_delete_account"
            app:backgroundTint="@color/black"
            android:textColor="@android:color/white" />
    </LinearLayout>

</LinearLayout>