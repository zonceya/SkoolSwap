<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@mipmap/ic_logo_round"
                android:contentDescription="SkoolSwap Logo"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SkoolSwap"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose Your School"
                android:textSize="16sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Progress Indicator -->
        <!-- Progress Indicator - 3 Steps: PROVINCE → SCHOOL → DONE -->
        <LinearLayout
            android:id="@+id/progressIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginBottom="32dp">

            <!-- Step 1: PROVINCE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <View
                    android:id="@+id/progressStep1Line"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/progress_line_active" />

                <ImageView
                    android:id="@+id/progressStep1Icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/dot_province_active" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="PROVINCE"
                    android:textSize="10sp"
                    android:textColor="#000000" />
            </LinearLayout>

            <!-- Step 2: SCHOOL -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <View
                    android:id="@+id/progressStep2Line"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/progress_line_inactive" />

                <ImageView
                    android:id="@+id/progressStep2Icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/dot_school_inactive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="SCHOOL"
                    android:textSize="10sp"
                    android:textColor="#999999" />
            </LinearLayout>

            <!-- Step 3: DONE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <View
                    android:id="@+id/progressStep3Line"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/progress_line_inactive" />

                <ImageView
                    android:id="@+id/progressStep3Icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/dot_end_inactive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="DONE"
                    android:textSize="10sp"
                    android:textColor="#999999" />
            </LinearLayout>
        </LinearLayout>

        <!-- Onboarding Title - ADDED BACK -->
        <TextView
            android:id="@+id/onboardingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Which school are you\nconnected to?"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Onboarding Message - ADDED BACK -->
        <TextView
            android:id="@+id/onboardingMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select your school to see uniforms, sportswear, and other items from your school community."
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="32dp"
            android:lineSpacingExtra="4dp" />

        <!-- Province Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Province"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/provinceTextInputLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Select your province"
            android:layout_marginBottom="24dp"
            app:startIconDrawable="@drawable/ic_location"
            app:startIconTint="#666666"
            app:boxStrokeColor="#999999"
            app:hintTextColor="#666666">

            <AutoCompleteTextView
                android:id="@+id/provinceSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:paddingStart="48dp"
                android:textColor="#000000" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- School Search -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Search School"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/schoolSearchLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Start typing..."
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="#666666"
            app:endIconMode="clear_text"
            app:endIconTint="#666666"
            app:boxStrokeColor="#999999"
            app:hintTextColor="#666666"
            android:layout_marginBottom="4dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/schoolSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:inputType="text"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#000000" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Example hint -->
        <TextView
            android:id="@+id/exampleHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Example: Westville Primary"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Province Empty Message -->
        <TextView
            android:id="@+id/provinceEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Select a province first"
            android:textSize="14sp"
            android:textColor="#999999"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- School Loading -->
        <ProgressBar
            android:id="@+id/schoolProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Search Results -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/schoolResultsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="250dp"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

        <!-- No Results -->
        <TextView
            android:id="@+id/noResultsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No schools found"
            android:textSize="14sp"
            android:textColor="#999999"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Selected School Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/selectedSchoolCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓ Selected School"
                    android:textSize="12sp"
                    android:textColor="#4CAF50" />

                <TextView
                    android:id="@+id/selectedSchoolName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Submit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/submitButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CONTINUE TO SKOOLSWAP"
            android:textStyle="bold"
            android:enabled="false"
            android:layout_marginTop="16dp"
            android:backgroundTint="#000000"
            android:textColor="#FFFFFF" />

        <!-- Loading Overlay -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>