<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="32dp"
        android:gravity="center_horizontal">

        <!-- Image/Illustration -->
        <ImageView
            android:id="@+id/onboardingImage"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:src="@drawable/ic_province"
            android:contentDescription="Onboarding Illustration"
            android:layout_marginBottom="24dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Your Province"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="To give you a customized experience, select your province"
            android:textSize="15sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="32dp"
            android:lineSpacingExtra="4dp" />

        <!-- 2-Dot Indicator (Province → School) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <!-- Province Dot (Active) -->
            <ImageView
                android:id="@+id/dotProvince"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/dot_active" />

            <!-- Connecting Line -->
            <View
                android:id="@+id/lineProvinceSchool"
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#000000" />

            <!-- School Dot (Inactive) -->
            <ImageView
                android:id="@+id/dotSchool"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/dot_inactive" />

        </LinearLayout>

        <!-- Province Dropdown -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Province"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/provinceTextInputLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/ic_location"
            app:startIconTint="#666666"
            app:boxStrokeColor="#999999"
            app:hintTextColor="#666666"
            app:hintEnabled="false">

            <AutoCompleteTextView
                android:id="@+id/provinceSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:paddingStart="48dp"
                android:textColor="#000000"
                android:textSize="16sp"
                android:hint="Select your province" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Error Message -->
        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Please select a province"
            android:textSize="14sp"
            android:textColor="#FF0000"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Continue Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CONTINUE"
            android:textStyle="bold"
            android:enabled="false"
            android:layout_marginTop="24dp"
            android:backgroundTint="#000000"
            android:textColor="#FFFFFF" />

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>