<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:scrollbars="vertical"
    android:fadeScrollbars="true"
    android:scrollbarSize="4dp"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Images Section (keep as is) -->
        <TextView
            android:id="@+id/images_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Images"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/images_subheading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/3 images selected"
            android:textColor="@android:color/darker_gray"
            android:paddingBottom="8dp"/>

        <LinearLayout
            android:id="@+id/image_placeholders"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp">

            <!-- Cover Photo -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/cover_photo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_create_item_placeholder"
                    android:background="@android:color/darker_gray"
                    android:contentDescription="Cover Photo"
                    android:scaleType="centerCrop"/>

                <ImageView
                    android:id="@+id/delete_cover"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/circle_background"
                    android:layout_gravity="top|end"
                    android:visibility="gone"
                    android:padding="4dp"
                    android:contentDescription="Delete"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cover"
                    android:textSize="12sp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="#80000000"
                    android:textColor="@android:color/white"/>
            </FrameLayout>

            <!-- Angle 2 -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/different_angle"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_create_item_placeholder"
                    android:background="@android:color/darker_gray"
                    android:contentDescription="Different Angle"
                    android:scaleType="centerCrop"/>

                <ImageView
                    android:id="@+id/delete_angle2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/circle_background"
                    android:layout_gravity="top|end"
                    android:visibility="gone"
                    android:padding="4dp"
                    android:contentDescription="Delete"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Angle 2"
                    android:textSize="12sp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="#80000000"
                    android:textColor="@android:color/white"/>
            </FrameLayout>

            <!-- Angle 3 -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp">

                <ImageView
                    android:id="@+id/label_photo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_create_item_placeholder"
                    android:background="@android:color/darker_gray"
                    android:contentDescription="Label"
                    android:scaleType="centerCrop"/>

                <ImageView
                    android:id="@+id/delete_angle3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/circle_background"
                    android:layout_gravity="top|end"
                    android:visibility="gone"
                    android:padding="4dp"
                    android:contentDescription="Delete"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Angle 3"
                    android:textSize="12sp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="#80000000"
                    android:textColor="@android:color/white"/>
            </FrameLayout>
        </LinearLayout>

        <!-- Item Name -->
        <TextView
            android:id="@+id/item_name_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item Name"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <EditText
            android:id="@+id/item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter item name"
            android:paddingBottom="8dp"/>

        <!-- Main Category -->
        <TextView
            android:id="@+id/main_category_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Main Category"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_arrow_drop_down">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/main_category_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select Category"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Sub Category -->
        <TextView
            android:id="@+id/sub_category_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sub Category"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_arrow_drop_down">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/sub_category_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select Sub Category"
                    android:focusable="false"
                    android:clickable="true"
                    android:inputType="none" />

            </com.google.android.material.textfield.TextInputLayout>

            <ProgressBar
                android:id="@+id/subcategory_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"/>

        </FrameLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/description_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <EditText
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Describe your item"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:paddingBottom="8dp"/>

        <!-- Condition -->
        <TextView
            android:id="@+id/condition_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Condition"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_arrow_drop_down">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/condition_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select Condition"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Size -->
        <TextView
            android:id="@+id/size_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Size"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_arrow_drop_down">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/size_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select Size"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Brand -->
        <TextView
            android:id="@+id/brand_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Brand"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_arrow_drop_down">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/brand_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select Brand"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Color -->
        <TextView
            android:id="@+id/color_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Color"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_arrow_drop_down">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/color_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select Color"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quantity (Keep as Spinner) -->
        <TextView
            android:id="@+id/quantity_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantity"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <Spinner
            android:id="@+id/quantity_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"/>

        <!-- Province -->
        <TextView
            android:id="@+id/province_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Province"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_arrow_drop_down">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/province_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select Province"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Town/City -->
        <TextView
            android:id="@+id/town_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Town/City"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_arrow_drop_down">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/town_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select Town/City"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Gender -->
        <TextView
            android:id="@+id/gender_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gender"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_arrow_drop_down">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/gender_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select Gender"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- School -->
        <TextView
            android:id="@+id/school_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="School"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:endIconMode="custom"
            app:endIconDrawable="@drawable/ic_arrow_drop_down">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/school_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select School"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Price -->
        <TextView
            android:id="@+id/price_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Price (R)"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <EditText
            android:id="@+id/price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:paddingBottom="8dp"/>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:paddingBottom="16dp"/>

        <!-- Submit Button -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submitButton"
            android:layout_width="match_parent"
            android:layout_height="76dp"
        android:textStyle="bold"
        android:textSize="26sp"
        android:textColor="@color/white"
        app:backgroundTint="@color/black"
        app:cornerRadius="8dp"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>

    </LinearLayout>
</ScrollView>