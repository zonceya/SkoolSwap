<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:scrollbars="vertical"
    android:fadeScrollbars="true"
    android:scrollbarSize="4dp"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Images Section -->
        <TextView
            android:id="@+id/images_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Images"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/images_subheading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/3 images selected"
            android:textColor="@android:color/darker_gray"
            android:paddingBottom="8dp"/>

        <LinearLayout
            android:id="@+id/image_placeholders"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp">

            <!-- Cover Photo with delete button -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/cover_photo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_create_item_placeholder"
                    android:background="@android:color/darker_gray"
                    android:contentDescription="Cover Photo"
                    android:scaleType="centerCrop"/>

                <ImageView
                    android:id="@+id/delete_cover"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/circle_background"
                    android:layout_gravity="top|end"
                    android:visibility="gone"
                    android:padding="4dp"
                    android:contentDescription="Delete"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cover"
                    android:textSize="12sp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="#80000000"
                    android:textColor="@android:color/white"/>
            </FrameLayout>

            <!-- Angle 2 with delete button -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/different_angle"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_create_item_placeholder"
                    android:background="@android:color/darker_gray"
                    android:contentDescription="Different Angle"
                    android:scaleType="centerCrop"/>

                <ImageView
                    android:id="@+id/delete_angle2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/circle_background"
                    android:layout_gravity="top|end"
                    android:visibility="gone"
                    android:padding="4dp"
                    android:contentDescription="Delete"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Angle 2"
                    android:textSize="12sp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="#80000000"
                    android:textColor="@android:color/white"/>
            </FrameLayout>

            <!-- Angle 3 with delete button -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp">

                <ImageView
                    android:id="@+id/label_photo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_create_item_placeholder"
                    android:background="@android:color/darker_gray"
                    android:contentDescription="Label"
                    android:scaleType="centerCrop"/>

                <ImageView
                    android:id="@+id/delete_angle3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/circle_background"
                    android:layout_gravity="top|end"
                    android:visibility="gone"
                    android:padding="4dp"
                    android:contentDescription="Delete"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Angle 3"
                    android:textSize="12sp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="#80000000"
                    android:textColor="@android:color/white"/>
            </FrameLayout>
        </LinearLayout>

        <!-- Item Name -->
        <TextView
            android:id="@+id/item_name_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item Name"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <EditText
            android:id="@+id/item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter item name"
            android:paddingBottom="8dp"/>

        <!-- Main Category -->
        <TextView
            android:id="@+id/main_category_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Main Category"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <Spinner
            android:id="@+id/main_category_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"/>

        <!-- Sub Category -->
        <TextView
            android:id="@+id/sub_category_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sub Category"
            android:textStyle="bold"
            android:paddingTop="8dp"/>
        <!-- Add this next to your subcategory spinner -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp">

            <Spinner
                android:id="@+id/sub_category_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"/>

            <ProgressBar
                android:id="@+id/subcategory_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"/>

        </FrameLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/description_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <EditText
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Describe your item"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:paddingBottom="8dp"/>

        <!-- Condition -->
        <TextView
            android:id="@+id/condition_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Condition"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <Spinner
            android:id="@+id/condition_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"/>

        <!-- Size -->
        <TextView
            android:id="@+id/size_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Size"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <Spinner
            android:id="@+id/size_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"/>

        <!-- Brand -->
        <TextView
            android:id="@+id/brand_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Brand"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <Spinner
            android:id="@+id/brand_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"/>

        <!-- Color -->
        <TextView
            android:id="@+id/color_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Color"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp">

            <Spinner
                android:id="@+id/color_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <ProgressBar
                android:id="@+id/color_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"/>

        </FrameLayout>

        <!-- Quantity -->
        <TextView
            android:id="@+id/quantity_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantity"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <Spinner
            android:id="@+id/quantity_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"/>

        <!-- Province -->
        <TextView
            android:id="@+id/province_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Province"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <Spinner
            android:id="@+id/province_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"/>

        <!-- Town/City -->
        <TextView
            android:id="@+id/town_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Town/City"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <Spinner
            android:id="@+id/town_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"/>

        <!-- Gender -->
        <TextView
            android:id="@+id/gender_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gender"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <Spinner
            android:id="@+id/gender_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"/>

        <!-- School -->
        <TextView
            android:id="@+id/school_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="School"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <Spinner
            android:id="@+id/school_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"/>

        <!-- Tags Section -->
        <TextView
            android:id="@+id/tags_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tags"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tags_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:visibility="gone"/>

        <!-- Selected Tags Display -->
        <TextView
            android:id="@+id/selected_tags_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No tags selected"
            android:textColor="@android:color/darker_gray"
            android:paddingBottom="8dp"
            android:visibility="gone"/>

        <!-- Price -->
        <TextView
            android:id="@+id/price_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Price (R)"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <EditText
            android:id="@+id/price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:paddingBottom="8dp"/>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:paddingBottom="16dp"/>

        <!-- Submit Button -->
        <com.google.android.material.button.MaterialButton
        android:id="@+id/submitButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Item"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:backgroundTint="@color/black"
        android:gravity="center"
        android:layout_margin="16dp"/>

    </LinearLayout>
</ScrollView>