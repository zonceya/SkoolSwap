<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="24dp">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Spacer for top -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <!-- Title -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter OTP Code"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="12dp" />

            <!-- Description -->
            <TextView
                android:id="@+id/descriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter the security code we just sent to your email"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="48dp"
                android:gravity="center_horizontal" />

            <!-- OTP Input Fields Row -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">

                <EditText
                    android:id="@+id/otpInput1"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:background="@drawable/otp_input_bg"
                    android:textColor="@color/black"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    app:layout_constraintEnd_toStartOf="@+id/otpInput2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintWidth_percent="0.14" />

                <EditText
                    android:id="@+id/otpInput2"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:background="@drawable/otp_input_bg"
                    android:textColor="@color/black"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    app:layout_constraintEnd_toStartOf="@+id/otpInput3"
                    app:layout_constraintStart_toEndOf="@+id/otpInput1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintWidth_percent="0.14" />

                <EditText
                    android:id="@+id/otpInput3"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:background="@drawable/otp_input_bg"
                    android:textColor="@color/black"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    app:layout_constraintEnd_toStartOf="@+id/otpInput4"
                    app:layout_constraintStart_toEndOf="@+id/otpInput2"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintWidth_percent="0.14" />

                <EditText
                    android:id="@+id/otpInput4"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:background="@drawable/otp_input_bg"
                    android:textColor="@color/black"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    app:layout_constraintEnd_toStartOf="@+id/otpInput5"
                    app:layout_constraintStart_toEndOf="@+id/otpInput3"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintWidth_percent="0.14" />

                <EditText
                    android:id="@+id/otpInput5"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:background="@drawable/otp_input_bg"
                    android:textColor="@color/black"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    app:layout_constraintEnd_toStartOf="@+id/otpInput6"
                    app:layout_constraintStart_toEndOf="@+id/otpInput4"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintWidth_percent="0.14" />

                <EditText
                    android:id="@+id/otpInput6"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="1"
                    android:background="@drawable/otp_input_bg"
                    android:textColor="@color/black"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:padding="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/otpInput5"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintWidth_percent="0.14" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!-- Verify Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonVerify"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Verify"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/black"
                app:cornerRadius="8dp"
                android:layout_marginBottom="16dp" />

            <!-- Resend OTP Timer -->
            <LinearLayout
                android:id="@+id/resendTimerLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:visibility="visible">

                <TextView
                    android:id="@+id/textResendOtp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resend OTP in "
                    android:textSize="14sp"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/textTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60s"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Resend OTP Button -->
            <TextView
                android:id="@+id/textResendOtpButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resend OTP"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="40dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>